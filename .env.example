# ============================================================
# TACER-RAG Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Optional: LLM API for correction engine ---
# Leave blank to use a local Ollama model instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Optional: Ollama local model ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Hugging Face token (only needed for gated models) ---
HF_TOKEN=

# --- Experiment tracking ---
# Set to 1 to enable Weights & Biases logging
WANDB_ENABLED=0
WANDB_PROJECT=tacer-rag
WANDB_API_KEY=

# --- Paths (override defaults if needed) ---
# TACER_DATA_DIR=d:/Text project/tacer-rag/data
# TACER_EXTERNAL_DIR=d:/Text project/tacer-rag/external
# TACER_EXPERIMENTS_DIR=d:/Text project/tacer-rag/experiments
