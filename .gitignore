# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and keys — NEVER COMMIT
.env
*.env
secrets.yaml
secrets.json

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Model checkpoints (large binary files — do NOT push to GitHub)
experiments/checkpoints/**/*.pt
experiments/checkpoints/**/*.bin
experiments/checkpoints/**/*.safetensors

# Keep the JSON metadata (small, useful for teammates)
!experiments/checkpoints/**/calibration_params.json
!experiments/checkpoints/**/training_args.json

# Downloaded data originals (re-downloadable)
external/RAGTruth/.git/
external/LettuceDetect/.git/

# Large processed data files (re-generated by scripts/preprocess_data.py)
data/processed/*.jsonl

# Prediction output files (re-generated by scripts/evaluate_detector.py)
experiments/predictions/*.jsonl

# Virtual environment (never push — teammates run: python -m venv .venv && pip install -r requirements.txt)
.venv/

# Figures / plots (re-generated)
experiments/figures/

# Experiment logs
experiments/logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
experiments/logs/*.log

# Hugging Face cache
.cache/

# pytest
.pytest_cache/
htmlcov/
.coverage
